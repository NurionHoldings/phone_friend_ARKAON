# Gradle start up script for POSIX generated by Gradle.
#

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

# Resolve links: $0 may be a link.
APP_HOME=$0
while [ -h "$APP_HOME" ]; do
    ls=$(ls -ld "$APP_HOME")
    link=${ls#*' -> '}
    case $link in
        /*) APP_HOME=$link ;;
        *) APP_HOME=$(dirname "$APP_HOME")/$link ;;
    esac
done
APP_HOME=$(cd "$(dirname "$APP_HOME")" >/dev/null 2>&1 && pwd -P) || exit 1

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set the JAVA_HOME variable in your environment to match the" >&2
        echo "location of your Java installation." >&2
        exit 1
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1; then
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    fi
fi

# The wrapper jar owns Gradle distribution selection and verification. Keep this
# launcher intentionally small and POSIX-compatible for local and CI execution.
# shellcheck disable=SC2086
exec "$JAVACMD" -Xmx64m -Xms64m $JAVA_OPTS $GRADLE_OPTS \
    "-Dorg.gradle.appname=$APP_BASE_NAME" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
